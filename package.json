{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:extension": "npm --prefix notification-extension run build",
    "build:browser": "npm run build:extension && npm --prefix browser-app run bundle",
    "build:electron": "npm run build:extension && npm --prefix electron-app run bundle",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start:browser": "npm --prefix browser-app start",
    "start:electron": "npm --prefix electron-app start",
    "watch:browser": "lerna run --parallel watch --ignore electron-app",
    "watch:electron": "lerna run --parallel watch --ignore browser-app",
    "test": "cd notification-extension && npm test"
  },
  "devDependencies": {
    "lerna": "^8.2.4"
  },
  "workspaces": [
    "notification-extension", "browser-app", "electron-app"
  ]
}
